{
  "$schema": "../schemas/guardrails.config.schema.json",
  "appName": "forgeboard-guardrails",
  "defaultBranch": "main",
  "statusContract": {
    "enabled": false
  },
  "coverage": "npm run test:coverage",
  "components": {
    "toolkit": {
      "paths": ["src/**", "schemas/**", "skills/**", "scripts/**"],
      "unitTest": "npm run test:unit",
      "integrationTest": "npm run test:harness"
    }
  }
}
