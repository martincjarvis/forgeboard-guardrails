{
  "name": "forgeboard-guardrails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Delivery-guardrails toolkit: standards, skills and the gates that enforce them. This package is the orchestrator for the repository's own gates (husky + lint-staged); the analysis tools are installed as development dependencies and pinned by the lock file (ADR-0002).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 hooks scripts",
    "test": "node --test hooks/test/hooks.test.mjs",
    "test:coverage": "c8 --check-coverage --lines=80 --reporter=text --reporter=cobertura node --test hooks/test/hooks.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell lint --no-progress --gitignore .",
    "gate:0": "node scripts/gate-0-baseline.mjs",
    "gate:7": "node scripts/gate-7-on-demand.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@secretlint/secretlint-rule-preset-recommend": "^8.2.4",
    "@types/node": "^22.10.0",
    "c8": "^10.1.3",
    "commitlint": "^19.6.0",
    "cspell": "^8.16.0",
    "diff-cover": "2.0.5",
    "eslint": "10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.4.2",
    "secretlint": "^8.2.4",
    "typescript": "^5.7.2"
  }
}
