{
  // Ignores only. File sets come from the call site: lint-staged passes staged
  // paths; the verify sweep passes its own glob. A "globs" entry here would
  // union with lint-staged's paths and widen every commit to the whole tree.
  "ignores": ["**/node_modules/**", "**/coverage/**", "**/dist/**"],
  // Link integrity as a lint feature: relative links and anchors must resolve.
  "customRules": ["markdownlint-rule-relative-links"],
  "config": {
    "MD013": false,
    "MD033": false,
    "relative-links": true,
  },
}
