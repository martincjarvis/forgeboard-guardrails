{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "local home directory path",
            "pattern": "/(?:C:\\\\Users\\\\|\\/home\\/|\\/Users\\/)[A-Za-z0-9._-]+/"
          },
          {
            "name": "UNC host path",
            "pattern": "/\\\\\\\\[A-Za-z0-9_-]+\\\\/"
          }
        ]
      }
    }
  ]
}
