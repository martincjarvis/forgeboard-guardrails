{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deploy descriptor",
  "type": "object",
  "required": ["appName", "components"],
  "additionalProperties": true,
  "properties": {
    "appName": { "type": "string" },
    "app": { "$ref": "#/$defs/hooks" },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "allOf": [{ "$ref": "#/$defs/hooks" }],
        "properties": {
          "type": {
            "enum": ["infra", "dbschema", "api", "library", "ui", "glue"]
          },
          "public": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "hookArray": { "type": "array", "items": { "type": "string" } },
    "hooks": {
      "type": "object",
      "properties": {
        "preDeploy": { "$ref": "#/$defs/hookArray" },
        "deploy": { "$ref": "#/$defs/hookArray" },
        "verify": { "$ref": "#/$defs/hookArray" },
        "postDeploy": { "$ref": "#/$defs/hookArray" }
      }
    }
  }
}
