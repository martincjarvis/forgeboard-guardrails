{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeboard.dev/schemas/guardrails.config.schema.json",
  "title": "ForgeBoard guardrails config",
  "type": "object",
  "required": ["appName", "defaultBranch", "components"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "appName": { "type": "string", "minLength": 1 },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "statusContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ticketIdPattern": { "type": "string" }
      }
    },
    "lintStaged": { "$ref": "#/definitions/commandMap" },
    "repo": { "$ref": "#/definitions/commandMap" },
    "coverage": {
      "description": "Repo-wide coverage command(s) run by the pre-push hook. The command owns the coverage threshold and must exit non-zero when coverage is below it.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "agentHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prSize": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warn": { "type": "integer", "minimum": 1 },
            "error": { "type": "integer", "minimum": 1 }
          }
        },
        "maxFileLines": { "type": "integer", "minimum": 1 },
        "codeExtensions": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "complexity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ccn": { "type": "integer", "minimum": 1 },
            "functionLines": { "type": "integer", "minimum": 1 },
            "params": { "type": "integer", "minimum": 1 }
          }
        },
        "configExtensions": { "type": "array", "items": { "type": "string" } },
        "testGlobs": { "type": "array", "items": { "type": "string" } },
        "agentDocs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "globs": { "type": "array", "items": { "type": "string" } },
            "warn": { "type": "integer", "minimum": 1 },
            "error": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "commandOrSequence": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      ]
    },
    "commandMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/commandOrSequence" }
    },
    "component": {
      "type": "object",
      "required": ["paths"],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "build": { "$ref": "#/definitions/commandOrSequence" },
        "unitTest": { "$ref": "#/definitions/commandOrSequence" },
        "integrationTest": { "$ref": "#/definitions/commandOrSequence" },
        "e2eTest": { "$ref": "#/definitions/commandOrSequence" },
        "e2eSmokeTest": { "$ref": "#/definitions/commandOrSequence" },
        "lintStaged": { "$ref": "#/definitions/commandMap" }
      }
    }
  }
}
