{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://forgeboard.dev/schemas/event.v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "ticketId",
    "timestamp",
    "type",
    "hook",
    "result",
    "commit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ticketId": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "const": "gate-run" },
    "hook": { "enum": ["commit-msg", "pre-commit"] },
    "result": { "enum": ["pass", "fail"] },
    "commit": { "type": "string" }
  }
}
